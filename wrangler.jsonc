{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lit-war-multiplayer",
  "main": "server/worker.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./build", "binding": "ASSETS", "run_worker_first": ["/api/*", "/openings/*", "/endings/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Classroom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Classroom"] }],
  "dev": { "port": 8787, "ip": "127.0.0.1" }
}
